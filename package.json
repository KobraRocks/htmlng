{
  "name": "htmlng",
  "version": "1.1.0",
  "description": "Deterministic, component-based static HTML generator built for AI agents.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "html",
    "static-site-generator",
    "cli",
    "ai-agents",
    "components",
    "deterministic"
  ],
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "htmlng": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KobraRocks/htmlng.git"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev:build": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
